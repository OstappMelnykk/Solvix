@page "/"
@implements IDisposable
@inject StackMonitor Monitor
@inject InstanceRegistry Registry
@inject ActionRunner Actions
@inject RawLogReader RawLogs
@inject PlanStore Plans

<PageTitle>Solvix Control</PageTitle>

@{
    var snap = Monitor.Current;
    var current = LaunchPlanner.Current(snap);
    var problems = LaunchPlanner.Validate(_plan);
    var steps = LaunchPlanner.Steps(_plan, current);
    var runSteps = steps.OfType<RunStep>().ToList();
    var manualStops = steps.OfType<ManualStopStep>().ToList();
    var running = snap.Components.Count(c => c.State != ComponentState.Down);
}

<section class="toolbar">
    <div>
        <h1>Стан системи</h1>
        <p class="muted">
            Працює @running з @snap.Components.Count ·
            @(snap.Time == DateTimeOffset.MinValue ? "збираю дані…" : "оновлено " + snap.Time.ToLocalTime().ToString("HH:mm:ss"))
        </p>
    </div>
    <div class="buttons">
        <button disabled="@Actions.Busy" @onclick='() => Run("Запуск dev (db + be + fe)", "up all")'>Старт dev</button>
        <button disabled="@Actions.Busy" @onclick='() => Run("Запуск demo (docker)", "demo")'>Старт demo</button>
        <button class="danger" disabled="@Actions.Busy" @onclick='() => Run("Зупинка всього", "down all")'>Зупинити все</button>
    </div>
</section>

@if (!snap.DockerAvailable)
{
    <div class="banner warn">Docker не відповідає — контейнери (db, web) недоступні. Colima запуститься сама при старті через скрипт.</div>
}

@if (Actions.CurrentTitle is not null)
{
    <div class="banner info">⏳ @Actions.CurrentTitle…</div>
}
else if (Actions.Last is { } last)
{
    <details class="banner @(last.Success ? "ok" : "bad")">
        <summary>@(last.Success ? "✔" : "✖") @last.Title · @last.Finished.ToLocalTime().ToString("HH:mm:ss")</summary>
        <pre>@last.Output</pre>
    </details>
}

<section class="plan">
    <div class="toolbar">
        <div>
            <h2>План запуску</h2>
            <p class="muted small">Обери, як запускати кожну частину. Панель зробить лише те, що відрізняється від поточного стану.</p>
        </div>
        <div class="buttons">
            <span class="muted small">Швидкий вибір:</span>
            <button class="ghost" @onclick="() => Preset(LaunchPlan.AllDocker)">Усе в Docker</button>
            <button class="ghost" @onclick="() => Preset(LaunchPlan.AllScript)">БД Docker · BE+FE скрипт</button>
            <button class="ghost" @onclick="() => Preset(LaunchPlan.BackendInIde)">BE в IDE · FE скрипт</button>
            <button class="ghost" @onclick="() => Preset(LaunchPlan.AllInIde)">BE+FE в IDE</button>
            <button class="ghost" @onclick="() => Preset(LaunchPlan.Nothing)">Нічого</button>
        </div>
    </div>

    <div class="plan-grid">
        @foreach (var (label, getter, setter, options, now) in PlanRows(current))
        {
            <div class="plan-row">
                <b>@label</b>
                <div class="seg">
                    @foreach (var m in options)
                    {
                        <button class="@(getter() == m ? "on" : "")" @onclick="() => { setter(m); Save(); }">@MethodName(m)</button>
                    }
                </div>
                <span class="muted small">зараз: @MethodName(now)</span>
            </div>
        }
    </div>

    @foreach (var error in problems.Errors) { <div class="banner bad">✖ @error</div> }
    @foreach (var warning in problems.Warnings) { <div class="banner warn">! @warning</div> }

    @if (steps.Count == 0 && problems.Ok)
    {
        <p class="muted small">Стан уже відповідає плану.</p>
    }
    else if (steps.Count > 0)
    {
        <ol class="steps">
            @foreach (var step in steps)
            {
                <li class="@StepClass(step)">@StepIcon(step) @step.Title</li>
            }
        </ol>
    }

    <div class="buttons">
        <button disabled="@(!problems.Ok || Actions.Busy || runSteps.Count == 0 || manualStops.Count > 0)" @onclick="() => Apply(runSteps)">
            Застосувати@(runSteps.Count > 0 ? $" ({runSteps.Count})" : "")
        </button>
        @if (manualStops.Count > 0)
        {
            <span class="muted small">Спершу зупини вручну те, що запущено з IDE/терміналу.</span>
        }
    </div>

    @if (steps.OfType<WaitForIdeStep>().Any())
    {
        <details class="hints" open>
            <summary>Як запустити з IDE</summary>
            <ul>
                <li><b>Backend</b> (Rider): конфігурація <code>Solvix.Api</code>, профіль <code>https</code>. Порт бази (5434) і адреса панелі беруться з <code>appsettings.Development.json</code>; базу запускає план.</li>
                <li><b>Frontend</b> (WebStorm / VS Code): скрипт <code>npm start</code> у теці <code>solvix-web</code> (ng serve, порт 4200).</li>
                <li>Щойно процес з'явиться, крок зникне з плану, а в таблиці буде видно, з якої IDE він запущений.</li>
            </ul>
        </details>
    }
</section>

<table class="grid">
    <thead>
        <tr><th></th><th>Компонент</th><th>Запущено через</th><th>Порт</th><th>Деталі</th><th>Навантаження</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var row in snap.Components)
    {
        <tr>
            <td><span class="dot @DotClass(row.State)" title="@row.State"></span></td>
            <td>
                <b>@row.Name</b>
                @if (row.Url is not null && row.State != ComponentState.Down)
                {
                    <br /><a href="@row.Url" target="_blank">@row.Url</a>
                }
            </td>
            <td><span class="tag @row.Launcher.Kind.ToString().ToLower()">@row.Launcher.Name</span></td>
            <td>@(row.Port is { } p ? ":" + p : "")</td>
            <td class="muted">@row.Detail</td>
            <td class="muted">@Load(row)</td>
            <td class="actions">
                @if (row.CanStart)
                {
                    <button disabled="@Actions.Busy" @onclick='() => Run("Старт: " + row.Name, row.StartAction!)'>Старт</button>
                }
                @if (row.CanStop)
                {
                    <button class="danger" disabled="@Actions.Busy" @onclick='() => Run("Стоп: " + row.Name, row.StopAction!)'>Стоп</button>
                }
                else if (row.State != ComponentState.Down && row.Launcher.Kind is LauncherKind.Ide or LauncherKind.Terminal or LauncherKind.Unknown && row.Kind != ComponentKind.Panel)
                {
                    <span class="muted small">зупиняється там, де запущено</span>
                }
                @if (row.LogSource is not null)
                {
                    <button class="ghost" @onclick="() => ShowRaw(row)">вивід</button>
                }
            </td>
        </tr>
    }
    </tbody>
</table>

@if (_rawTitle is not null)
{
    <section class="raw">
        <div class="toolbar"><h2>Вивід: @_rawTitle</h2><button class="ghost" @onclick="() => _rawTitle = null">закрити</button></div>
        <pre>@_rawText</pre>
    </section>
}

@if (snap.OtherContainers.Count > 0)
{
    <p class="muted small other">Інші контейнери в Docker (не Solvix, панель їх не чіпає):
        @string.Join(", ", snap.OtherContainers.Select(c => c.Name))</p>
}

@code {
    private LaunchPlan _plan = LaunchPlan.AllScript;
    private string? _rawTitle;
    private string _rawText = "";
    private Timer? _tick;

    protected override void OnInitialized()
    {
        _plan = Plans.Load();
        Monitor.Changed += OnChanged;
        Registry.Changed += OnChanged;
        Actions.Changed += OnChanged;
        // Uptime/age text moves even when nothing changes.
        _tick = new Timer(_ => OnChanged(), null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    private static readonly Method[] DbMethods = [Method.Off, Method.Docker];
    private static readonly Method[] AppMethods = [Method.Off, Method.Docker, Method.Script, Method.Ide];

    private IEnumerable<(string Label, Func<Method> Get, Action<Method> Set, Method[] Options, Method Now)> PlanRows(LaunchPlan current) =>
    [
        ("База даних", () => _plan.Db, m => _plan = _plan with { Db = m }, DbMethods, current.Db),
        ("Backend", () => _plan.Backend, m => _plan = _plan with { Backend = m }, AppMethods, current.Backend),
        ("Frontend", () => _plan.Frontend, m => _plan = _plan with { Frontend = m }, AppMethods, current.Frontend),
    ];

    private void Preset(LaunchPlan plan) { _plan = plan; Save(); }

    private void Save() => Plans.Save(_plan);

    private async Task Apply(IReadOnlyList<RunStep> steps)
    {
        await Actions.RunSequenceAsync("План запуску", steps.Select(s => s.Arguments).ToList());
        await Monitor.RefreshAsync();
    }

    private static string MethodName(Method m) => m switch
    {
        Method.Off => "вимкнено",
        Method.Docker => "Docker",
        Method.Script => "термінал (скрипт)",
        _ => "IDE",
    };

    private static string StepIcon(PlanStep step) => step switch
    {
        RunStep => "▶",
        WaitForIdeStep => "⏳",
        _ => "✋",
    };

    private static string StepClass(PlanStep step) => step switch
    {
        WaitForIdeStep => "wait",
        ManualStopStep => "manual",
        _ => "",
    };

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task Run(string title, string arguments)
    {
        await Actions.RunAsync(title, arguments);
        await Monitor.RefreshAsync();
    }

    private async Task ShowRaw(ComponentRow row)
    {
        _rawTitle = row.Name;
        _rawText = "завантаження…";
        _rawText = await RawLogs.TailAsync(row.LogSource!);
    }

    private static string DotClass(ComponentState state) => state switch
    {
        ComponentState.Running => "ok",
        ComponentState.Down => "off",
        _ => "warn",
    };

    private static string Load(ComponentRow row)
    {
        if (row.Instance is not { } view)
        {
            return "";
        }
        var age = DateTimeOffset.UtcNow - view.Info.StartedAt;
        var m = view.Info.Metrics;
        var uptime = age.TotalHours >= 1 ? $"{(int)age.TotalHours} год {age.Minutes} хв" : $"{age.Minutes} хв {age.Seconds} с";
        return m is null
            ? $"аптайм {uptime}"
            : $"аптайм {uptime} · {m.WorkingSetMb:0} МБ · cpu {m.CpuPercent:0.#}% · {view.RequestsPerSecond:0.#} req/s · активних {m.ActiveRequests}";
    }

    public void Dispose()
    {
        Monitor.Changed -= OnChanged;
        Registry.Changed -= OnChanged;
        Actions.Changed -= OnChanged;
        _tick?.Dispose();
    }
}
